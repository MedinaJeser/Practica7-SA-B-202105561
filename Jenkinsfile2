pipeline {
    agent none

    stages {
        stage('Build & Test Users (NestJS)') {
            agent {
                label 'node-agent'  // Agente con Node.js instalado
            }
            steps {
                dir('users') {
                    echo '🔨 Building users (NestJS)...'
                    sh 'npm install'
                    echo '🧪 Testing users (NestJS)...'
                    sh 'npm run test'
                }
            }
        }

        stage('Build & Test Courses (NestJS)') {
            agent {
                label 'node-agent'  // Agente con Node.js instalado
            }
            steps {
                dir('courses') {
                    echo '🔨 Building courses (NestJS)...'
                    sh 'npm install'
                    echo '🧪 Testing courses (NestJS)...'
                    sh 'npm run test'
                }
            }
        }

        stage('Build & Test Enrollments (Python)') {
            agent {
                label 'python-agent'  // Agente con Python instalado
            }
            steps {
                dir('enrollments') {
                    echo '🔨 Building enrollments (Python)...'
                    sh 'pip3 install -r requirements.txt'
                    echo '🧪 Testing enrollments (Python)...'
                    sh 'pytest'
                }
            }
        }

        stage('Build & Test Evaluations (Python)') {
            agent {
                label 'python-agent'  // Agente con Python instalado
            }
            steps {
                dir('evaluations') {
                    echo '🔨 Building evaluations (Python)...'
                    sh 'pip3 install -r requirements.txt'
                    echo '🧪 Testing evaluations (Python)...'
                    sh 'pytest'
                }
            }
        }
    }
}
